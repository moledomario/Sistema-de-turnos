# Copiar a .env.local y completar. El .env real nunca se sube.

# URL del backend. Next.js reemplaza las NEXT_PUBLIC_* en tiempo de build, así
# que después de cambiarla hay que volver a buildear.
# Si no se define, el front apunta a http://localhost:3001 (desarrollo local).
NEXT_PUBLIC_API_URL=http://localhost:3001
