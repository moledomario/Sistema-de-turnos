# Copiar a .env y completar. El .env real nunca se sube (está en .gitignore).

# --- Obligatorias: sin estas el server no arranca ---

# Postgres. DATABASE_URL la usa Prisma para las migraciones y
# DATABASE_CONNECTION la usa el cliente en runtime (src/lib/prisma.js).
DATABASE_URL=postgresql://usuario:password@localhost:5432/turnos
DATABASE_CONNECTION=postgresql://usuario:password@localhost:5432/turnos

# Firma de los tokens de sesión. En producción, una cadena larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# --- Opcionales ---

# URL pública del front. Se usa para armar los links de los mails (por ejemplo
# el de recuperar contraseña) y, si no hay CORS_ORIGINS, como único origen
# permitido por CORS.
APP_URL=http://localhost:3000

# Orígenes permitidos por CORS, separados por coma. Solo hace falta si son más
# de uno (ej. el dominio de producción y el de preview).
# CORS_ORIGINS=https://turnos.app,https://preview.turnos.app

# Cantidad de proxies delante del server (Render, Railway, Nginx ponen 1). Sin
# esto el rate limit ve el IP del proxy para todos y limita a todo el mundo junto.
# TRUST_PROXY=1

# Envío de mails (Resend). Si RESEND_API_KEY está vacía no se rompe nada: los
# avisos se loguean por consola en vez de mandarse.
RESEND_API_KEY=
MAIL_FROM=Turnos <onboarding@resend.dev>

# Zona horaria del negocio. NO es cosmética: los horarios de atención se guardan
# como minutos desde la medianoche de ESTA zona, así que de acá salen los turnos
# que se ofrecen y la validación de si un horario cae dentro de la atención.
# Si el server corre en UTC (lo normal en Render/Railway) y esto está mal, todos
# los turnos se corren de lugar. Cambiarla con turnos ya cargados los reinterpreta.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Puerto de escucha (por defecto 3001).
# PORT=3001

# --- Mercado Pago (cobro de los planes a los profesionales) ---

# Access Token de la aplicación, de "Tus integraciones > Credenciales". Va SOLO
# acá: nunca en una NEXT_PUBLIC_*, que Next mete en el bundle del navegador.
# Empezá con el de prueba (arranca con TEST-); el de producción cobra de verdad.
# Sin esta variable el resto de la app funciona igual: lo único que falla es
# suscribirse, con un 503 y un mensaje claro.
MP_ACCESS_TOKEN=

# Clave secreta de la firma de los webhooks, de "Tus integraciones > Webhooks >
# Configurar notificación". Sin esto el webhook rechaza TODAS las
# notificaciones: la URL es pública y la firma es lo único que distingue un
# aviso real de Mercado Pago de uno que mandó cualquiera con curl.
MP_WEBHOOK_SECRET=

# La URL del webhook que hay que cargar en el panel de MP es:
#   https://TU-DOMINIO-DEL-SERVER/billing/webhook
# con los eventos "Suscripciones" (subscription_preapproval) y "Cuotas de
# suscripción" (subscription_authorized_payment). Necesita dominio público, así
# que esto recién se puede configurar después del deploy.
